# Copy to .env and export before running, or pass as environment variables.
#
# Note: when running via `docker compose up`, the `app` service overrides
# DB_HOST to `postgres` (the compose service name) so the value below is
# only used when running the app outside Docker (e.g. `mvn spring-boot:run`).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_price_monitor
DB_USER=monitor
DB_PASSWORD=monitor

ALTERLAB_API_KEY=
ALTERLAB_BASE_URL=https://api.alterlab.io/api/v1

NOTIFICATION_TYPE=log

# Used when NOTIFICATION_TYPE=slack
SLACK_WEBHOOK_URL=

SERVER_PORT=8080
SCHEDULER_ENABLED=true
# Default ms when scheduler_settings row is created without Flyway. Live value: DB + UI.
SCHEDULER_INTERVAL_MS=3600000

# Gemini-backed 7-day price summary on alerts. If unset / disabled / failing,
# a deterministic fallback summary (computed from DB stats) is sent instead;
# the alert path is never blocked by the AI call.
GEMINI_ENABLED=true
GEMINI_API_KEY=AIzaSyAY_QclVvO5wHJjUubcn-aHyKaVc2EZHqY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=5000
