# Copy to `.env.local` next to `docker-compose.yml` for Docker Compose (`env_file`), or export
# these variables before `mvn spring-boot:run`.
#
# Docker: `docker-compose.yml` sets `DB_HOST=postgres` in the `app` service so the DB below is
# only for runs outside Compose (e.g. local Postgres on localhost:5432).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_price_monitor
DB_USER=monitor
DB_PASSWORD=monitor

ALTERLAB_API_KEY=
ALTERLAB_BASE_URL=https://api.alterlab.io/api/v1

# --- Notifications (any combination; see docs/configuration.md) ---
# Recipient lists (email + SMS) are entered in the SPA / `PUT /api/admin/notification-recipients`
# and persisted in the DB. Only sender / credential config lives here.
NOTIFY_LOG_ENABLED=true
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_SUBJECT_PREFIX=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_TIMEOUT_MS=10000

NOTIFY_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_BASE_URL=https://api.twilio.com/2010-04-01
NOTIFY_SMS_TIMEOUT_MS=5000

# When true, POST /api/admin/send-test-notification sends a synthetic alert (no DB changes).
# Turn off in any shared or public deployment — /api/admin has no auth.
ADMIN_ALLOW_TEST_NOTIFICATION=false

SERVER_PORT=8080
SCHEDULER_ENABLED=true
# Default ms when scheduler_settings row is created without Flyway. Live value: DB + UI.
SCHEDULER_INTERVAL_MS=3600000

# Gemini-backed 7-day price summary on alerts. If unset / disabled / failing,
# a deterministic fallback summary (computed from DB stats) is sent instead;
# the alert path is never blocked by the AI call.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=5000
